# ===== تسجيل الدخول (إلزامي قبل أي نشر على الإنترنت — بدونه مفيش محتوى خلاص) =====
# كلمة سر الدخول الوحيدة للأدمن (الرئيس التنفيذي) — 8 حروف فأكثر وإلا الدخول هيقفول
ADMIN_PASSWORD=
# مفتاح توقيع جلسات الدخول — ولّده مرة واحدة ولا تغيّره (تغييره بيطرّد كل الجلسات)
# ولّده بـ: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ===== قاعدة البيانات (SQLite) =====
DATABASE_URL=file:./db/custom.db

# ===== مفتاح تشفير مفاتيح الـ API في القاعدة (اختياري بس مستحسن) =====
# لو محددتش، التطبيق بيولّد ملف db/.secret.key تلقائياً — لو غيرته هتفقد المفاتيح القديمة
APP_SECRET=

# ===== مفتاح Gemini من بيئة الخادم (اختياري) =====
# بيتسجل تلقائياً في تبويب المفاتيح ويظهر للدوران مع باقي المفاتيح
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.8-flash

# ===== AshnaAI (اختياري — مزوّد إضافي قدام الطبقة الحالية) =====
# بدون المفتاح ده كل مسارات الذكاء الاصطناعي شغالة زي ما هي (ZAI/BYOK) ولا تغيير في السلوك.
# المفتاح يُنشأ من app.ashna.ai/account/api ويقعد على السيرفر بس — مبيوصلش للمتصفح أبدًا.
ASHNA_API_KEY=
# الموديل الافتراضي لو مفيش اختيار من الواجهة (اختياري)
ASHNA_MODEL_ID=glm-5.3-flash
# حرس التكلفة: قائمة موديلات مسموحة مفصولة بفواصل (مثال: glm-5.3-flash,deepseek-v4).
# فاضية أو غير محددة = الكتالوج كله مسموح بقرار صريح منك. أي موديل خارجها يرجّع 403.
# الكتالوج مبيوفّرش بيانات تسعير — مجانية أي موديل أو تكلفته حسب حساب AshnaAI نفسه.
ASHNA_ALLOWED_MODELS=
