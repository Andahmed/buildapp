# ===== قاعدة البيانات (SQLite) =====
DATABASE_URL=file:/absolute/path/to/your/project/db/custom.db

# ===== مفتاح تشفير مفاتيح الـ API في القاعدة (اختياري بس مستحسن) =====
# لو محددتش، التطبيق بيولّد ملف db/.secret.key تلقائياً — لو غيرته هتفقد المفاتيح القديمة
APP_SECRET=

# ===== مفتاح Gemini من بيئة الخادم (اختياري) =====
# بيتسجل تلقائياً في تبويب المفاتيح ويظهر للدوران مع باقي المفاتيح
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.8-flash
